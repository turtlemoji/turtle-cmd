# Dev tokens: .npmrc, .pypirc, .netrc, kube, docker
DEV_TOKENS_FOUND=0
declare -a DEV_TOKENS_LIST=()

check_dev_tokens() {
    DEV_TOKENS_FOUND=0
    DEV_TOKENS_LIST=()

    # .npmrc with auth token
    if [[ -f "$HOME/.npmrc" ]]; then
        if grep -qE '(//.*:_authToken=|_auth=|_password=)' "$HOME/.npmrc" 2>/dev/null; then
            DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + 1))
            DEV_TOKENS_LIST+=("~/.npmrc (contains auth token)")
        fi
    fi

    # .pypirc with password
    if [[ -f "$HOME/.pypirc" ]]; then
        if grep -qE '(password|token)\s*=' "$HOME/.pypirc" 2>/dev/null; then
            DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + 1))
            DEV_TOKENS_LIST+=("~/.pypirc (contains password/token)")
        fi
    fi

    # .netrc with passwords
    if [[ -f "$HOME/.netrc" ]]; then
        if grep -qiE 'password' "$HOME/.netrc" 2>/dev/null; then
            DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + 1))
            DEV_TOKENS_LIST+=("~/.netrc (contains passwords)")
        fi
        # Check permissions
        local perms
        if [[ "$OS_TYPE" == "linux" ]]; then
            perms=$(stat -c %a "$HOME/.netrc" 2>/dev/null)
        else
            perms=$(stat -f %Lp "$HOME/.netrc" 2>/dev/null)
        fi
        if [[ -n "$perms" ]] && [[ "$perms" != "600" ]] && [[ "$perms" != "400" ]]; then
            DEV_TOKENS_LIST+=("~/.netrc bad permissions (mode: $perms, should be 600)")
        fi
    fi

    # Kubernetes config with credentials
    if [[ -f "$HOME/.kube/config" ]]; then
        if grep -qE '(client-certificate-data|client-key-data|token:|password:)' "$HOME/.kube/config" 2>/dev/null; then
            DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + 1))
            DEV_TOKENS_LIST+=("~/.kube/config (contains credentials)")
        fi
    fi

    # Docker registry auth
    if [[ -f "$HOME/.docker/config.json" ]]; then
        if grep -qE '"auth"' "$HOME/.docker/config.json" 2>/dev/null; then
            DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + 1))
            DEV_TOKENS_LIST+=("~/.docker/config.json (contains registry auth)")
        fi
    fi

    # Terraform state with secrets
    local tf_count=0
    while IFS= read -r tfstate; do
        tf_count=$((tf_count + 1))
        [[ $tf_count -le 3 ]] && DEV_TOKENS_LIST+=("$tfstate (may contain plaintext secrets)")
    done < <(find "$HOME" -maxdepth 4 -name "terraform.tfstate" \
        -not -path "*/.terraform/*" \
        -not -path "*/.cache/*" 2>/dev/null | head -5)
    if [[ $tf_count -gt 0 ]]; then
        DEV_TOKENS_FOUND=$((DEV_TOKENS_FOUND + tf_count))
    fi

    [[ "$DEV_TOKENS_FOUND" -eq 0 ]]
}

