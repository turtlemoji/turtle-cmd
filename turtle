# ═══════════════════════════════════════════════════════════════════════════════
# NETWORK SECURITY CHECKS (max ~200 pts)
# ═══════════════════════════════════════════════════════════════════════════════

check_open_ports() {
    local dangerous_ports=(21 23 25 69 110 143 445 513 514)
    local listening_ports

    if command -v ss &>/dev/null; then
        listening_ports=$(ss -tlnH 2>/dev/null | awk '{print $4}' | grep -oE '[0-9]+$')
    elif command -v netstat &>/dev/null; then
        listening_ports=$(netstat -tlnp 2>/dev/null | awk 'NR>2 {print $4}' | grep -oE '[0-9]+$')
    else
        return 0  # Can't check
    fi

    for port in "${dangerous_ports[@]}"; do
        if echo "$listening_ports" | grep -q "^${port}$"; then
            return 1
        fi
    done
    return 0
}

check_dns_encryption() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for systemd-resolved with DoT
        if systemctl is-active systemd-resolved &>/dev/null; then
            resolvectl status 2>/dev/null | grep -qi "DNS over TLS"
        # Check for dnscrypt-proxy
        elif systemctl is-active dnscrypt-proxy &>/dev/null; then
            return 0
        # Check resolv.conf for known DoH/DoT providers
        elif grep -qE "(1\.1\.1\.1|8\.8\.8\.8|9\.9\.9\.9)" /etc/resolv.conf 2>/dev/null; then
            # Known providers but might not be encrypted
            return 1
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check if encrypted DNS is configured (macOS 11+)
        if [[ -f /etc/resolver/* ]] 2>/dev/null; then
            return 0
        fi
        # Check for DNS profile
        profiles list 2>/dev/null | grep -qi "dns"
    else
        return 1
    fi
}


check_ipv6_privacy() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check sysctl for IPv6 privacy extensions
        local use_tempaddr
        use_tempaddr=$(sysctl -n net.ipv6.conf.all.use_tempaddr 2>/dev/null || echo "0")
        [[ "$use_tempaddr" -ge 1 ]]
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS has privacy extensions enabled by default
        return 0
    else
        return 1
    fi
}

run_network_checks() {
    local category="NETWORK SECURITY"

    run_check "$category" "No dangerous open ports" 75 "check_open_ports" || true
    run_check "$category" "Encrypted DNS configured" 50 "check_dns_encryption" || true
    run_check "$category" "IPv6 privacy extensions" 25 "check_ipv6_privacy" || true
}

# ═══════════════════════════════════════════════════════════════════════════════
# SERVICES & PROCESSES CHECKS (max ~150 pts)
# ═══════════════════════════════════════════════════════════════════════════════

check_cron_jobs() {
    # Check for suspicious cron jobs (ones that download/execute from internet)
    local suspicious=0

    # Check user crontab
    if crontab -l 2>/dev/null | grep -Ei "(curl|wget|bash.*http|nc\s+-e)" &>/dev/null; then
        suspicious=1
    fi

    # Check system cron directories
    for crondir in /etc/cron.d /etc/cron.daily /etc/cron.hourly /etc/cron.weekly /etc/cron.monthly; do
        if [[ -d "$crondir" ]]; then
            if grep -rEi "(curl|wget).*\|.*bash" "$crondir" 2>/dev/null | grep -v "^#" &>/dev/null; then
                suspicious=1
            fi
        fi
    done

    [[ $suspicious -eq 0 ]]
}

check_core_dumps_disabled() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check ulimit
        local core_limit
        core_limit=$(ulimit -c 2>/dev/null)
        if [[ "$core_limit" == "0" ]]; then
            return 0
        fi

        # Check sysctl
        local core_pattern
        core_pattern=$(sysctl -n kernel.core_pattern 2>/dev/null || echo "")
        [[ "$core_pattern" == "|/bin/false" || "$core_pattern" == "" ]]
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check core dump directory
        local core_limit
        core_limit=$(launchctl limit core 2>/dev/null | awk '{print $2}')
        [[ "$core_limit" == "0" ]]
    else
        return 1
    fi
}

check_kernel_hardening() {
    if [[ "$OS_TYPE" != "linux" ]]; then
        return 0  # Skip for non-Linux
    fi

    local hardened=0
    local total=0

    # Check ASLR
    local aslr
    aslr=$(sysctl -n kernel.randomize_va_space 2>/dev/null || echo "0")
    [[ "$aslr" -ge 2 ]] && ((hardened++))
    ((total++))

    # Check ptrace scope
    local ptrace
    ptrace=$(sysctl -n kernel.yama.ptrace_scope 2>/dev/null || echo "0")
    [[ "$ptrace" -ge 1 ]] && ((hardened++))
    ((total++))

    # Check dmesg restriction
    local dmesg
    dmesg=$(sysctl -n kernel.dmesg_restrict 2>/dev/null || echo "0")
    [[ "$dmesg" -ge 1 ]] && ((hardened++))
    ((total++))

    # Pass if at least 2 of 3 are enabled
    [[ $hardened -ge 2 ]]
}

run_services_checks() {
    local category="SERVICES"

    run_check "$category" "No suspicious cron jobs" 50 "check_cron_jobs" || true
    run_check "$category" "Core dumps disabled" 50 "check_core_dumps_disabled" || true

    if [[ "$OS_TYPE" == "linux" ]]; then
        run_check "$category" "Kernel hardening enabled" 50 "check_kernel_hardening" || true
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM HARDENING CHECKS
# ═══════════════════════════════════════════════════════════════════════════════

FAILED_LOGINS=0
EXPOSED_SERVICES=0
declare -a EXPOSED_SERVICES_LIST=()

check_failed_logins() {
    # Check for recent failed login attempts (potential brute force)
    FAILED_LOGINS=0

    if [[ "$OS_TYPE" == "linux" ]]; then
        if [[ -r /var/log/auth.log ]]; then
            FAILED_LOGINS=$(grep -c "Failed password" /var/log/auth.log 2>/dev/null || echo "0")
        elif [[ -r /var/log/secure ]]; then
            FAILED_LOGINS=$(grep -c "Failed password" /var/log/secure 2>/dev/null || echo "0")
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check last few days of logs
        FAILED_LOGINS=$(log show --predicate 'eventMessage contains "failed"' --style syslog --last 7d 2>/dev/null | grep -ci "authentication" || echo "0")
    fi

    [[ -z "$FAILED_LOGINS" ]] && FAILED_LOGINS=0
    [[ "$FAILED_LOGINS" =~ ^[0-9]+$ ]] || FAILED_LOGINS=0

    # More than 50 failed logins in recent logs is concerning
    [[ "$FAILED_LOGINS" -lt 50 ]]
}

check_services_exposed() {
    # Check for services listening on 0.0.0.0 (all interfaces)
    EXPOSED_SERVICES=0
    EXPOSED_SERVICES_LIST=()

    if command -v ss &>/dev/null; then
        while IFS= read -r line; do
            EXPOSED_SERVICES_LIST+=("$line")
            EXPOSED_SERVICES=$((EXPOSED_SERVICES + 1))
        done < <(ss -tlnp 2>/dev/null | grep "0.0.0.0:" | grep -v "127.0.0.1" | awk '{print $4 " " $6}' | head -10)
    elif command -v netstat &>/dev/null; then
        while IFS= read -r line; do
            EXPOSED_SERVICES_LIST+=("$line")
            EXPOSED_SERVICES=$((EXPOSED_SERVICES + 1))
        done < <(netstat -tlnp 2>/dev/null | grep "0.0.0.0:" | awk '{print $4 " " $7}' | head -10)
    fi

    # A few exposed services is normal, but many is concerning
    [[ "$EXPOSED_SERVICES" -lt 5 ]]
}

check_usb_automount() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check if udisks2 automount is enabled
        if command -v gsettings &>/dev/null; then
            local automount
            automount=$(gsettings get org.gnome.desktop.media-handling automount 2>/dev/null || echo "false")
            [[ "$automount" == "false" ]]
        else
            # Check udev rules for USB automount
            ! grep -rq "automount" /etc/udev/rules.d/ 2>/dev/null
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS always automounts by default, check if disabled
        defaults read /Library/Preferences/SystemConfiguration/com.apple.DiskArbitration.diskarbitrationd.plist DADisableEjectNotification 2>/dev/null | grep -q "1" || return 1
    fi
    return 0
}

check_bluetooth_discoverable() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check bluetoothctl or hciconfig
        if command -v bluetoothctl &>/dev/null; then
            ! bluetoothctl show 2>/dev/null | grep -q "Discoverable: yes"
        else
            return 0  # Bluetooth not installed
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check if Bluetooth is discoverable
        local discoverable
        discoverable=$(defaults read /Library/Preferences/com.apple.Bluetooth ControllerPowerState 2>/dev/null || echo "0")
        # If Bluetooth is off, it's secure
        [[ "$discoverable" == "0" ]] && return 0
        # Check discoverability - hard to check on macOS, assume ok if BT is managed
        return 0
    fi
    return 0
}

check_wifi_autoconnect() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check NetworkManager for auto-connect to open networks
        if command -v nmcli &>/dev/null; then
            # Check if any connection has no security and autoconnect
            local open_autoconnect
            open_autoconnect=$(nmcli -t -f NAME,TYPE,AUTOCONNECT,SECURITY connection show 2>/dev/null | grep "wifi" | grep "yes" | grep -c "::" || echo "0")
            [[ "$open_autoconnect" -eq 0 ]]
        else
            return 0
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check for auto-join open networks setting
        local autojoin
        autojoin=$(defaults read /Library/Preferences/SystemConfiguration/com.apple.airport.preferences RememberRecentNetworks 2>/dev/null || echo "1")
        # If remembering networks, check if any are open
        # This is complex on macOS, assume reasonable default
        return 0
    fi
    return 0
}

