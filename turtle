# VPN/WiFi configs with embedded keys
VPN_CONFIGS_FOUND=0
declare -a VPN_CONFIGS_LIST=()

check_vpn_wifi_configs() {
    VPN_CONFIGS_FOUND=0
    VPN_CONFIGS_LIST=()

    # OpenVPN configs with embedded keys
    while IFS= read -r ovpn; do
        if grep -qE '<(key|cert|tls-auth)>' "$ovpn" 2>/dev/null; then
            VPN_CONFIGS_FOUND=$((VPN_CONFIGS_FOUND + 1))
            VPN_CONFIGS_LIST+=("OpenVPN (embedded key): $ovpn")
        fi
    done < <(find "$HOME" -maxdepth 4 -name "*.ovpn" \
        -not -path "*/.cache/*" \
        -not -path "*/.Trash/*" 2>/dev/null | head -10)

    # WireGuard configs with private keys
    local wg_paths=("/etc/wireguard" "$HOME/.config/wireguard" "$HOME/wireguard")
    for wdir in "${wg_paths[@]}"; do
        if [[ -d "$wdir" ]]; then
            while IFS= read -r wgconf; do
                if grep -qE 'PrivateKey\s*=' "$wgconf" 2>/dev/null; then
                    VPN_CONFIGS_FOUND=$((VPN_CONFIGS_FOUND + 1))
                    VPN_CONFIGS_LIST+=("WireGuard (private key): $wgconf")
                fi
            done < <(find "$wdir" -name "*.conf" 2>/dev/null | head -5)
        fi
    done

    # Saved WiFi passwords (Linux NetworkManager)
    if [[ "$OS_TYPE" == "linux" ]] && [[ -d "/etc/NetworkManager/system-connections" ]]; then
        local wifi_count=0
        wifi_count=$(find /etc/NetworkManager/system-connections -name "*.nmconnection" -readable 2>/dev/null | wc -l)
        if [[ $wifi_count -gt 0 ]]; then
            # Check if they contain plaintext passwords
            local pw_count=0
            while IFS= read -r nmfile; do
                if grep -qE 'psk=' "$nmfile" 2>/dev/null; then
                    pw_count=$((pw_count + 1))
                fi
            done < <(find /etc/NetworkManager/system-connections -name "*.nmconnection" -readable 2>/dev/null)
            if [[ $pw_count -gt 0 ]]; then
                VPN_CONFIGS_FOUND=$((VPN_CONFIGS_FOUND + pw_count))
                VPN_CONFIGS_LIST+=("WiFi passwords readable: $pw_count networks in /etc/NetworkManager/")
            fi
        fi
    fi

    # FileZilla saved credentials
    local filezilla_paths=(
        "$HOME/.config/filezilla/sitemanager.xml"
        "$HOME/.filezilla/sitemanager.xml"
        "$HOME/Library/Application Support/FileZilla/sitemanager.xml"
    )
    for fz in "${filezilla_paths[@]}"; do
        if [[ -f "$fz" ]]; then
            if grep -qE '<Pass' "$fz" 2>/dev/null; then
                VPN_CONFIGS_FOUND=$((VPN_CONFIGS_FOUND + 1))
                VPN_CONFIGS_LIST+=("FileZilla saved passwords: $fz")
            fi
        fi
    done

    [[ "$VPN_CONFIGS_FOUND" -eq 0 ]]
}

