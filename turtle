check_telemetry() {
    TELEMETRY_ISSUES=0
    TELEMETRY_LIST=()

    # VS Code telemetry
    local vscode_settings=(
        "$HOME/.config/Code/User/settings.json"
        "$HOME/.config/Code - Insiders/User/settings.json"
        "$HOME/Library/Application Support/Code/User/settings.json"
    )
    for vsfile in "${vscode_settings[@]}"; do
        if [[ -f "$vsfile" ]]; then
            # Check if telemetry is NOT disabled
            if ! grep -qE '"telemetry\.(telemetryLevel|enableTelemetry)".*"(off|false)"' "$vsfile" 2>/dev/null; then
                TELEMETRY_ISSUES=$((TELEMETRY_ISSUES + 1))
                TELEMETRY_LIST+=("VS Code telemetry enabled")
                break
            fi
        fi
    done

    # Firefox telemetry
    local ff_dir="$HOME/.mozilla/firefox"
    [[ "$OS_TYPE" == "macos" ]] && ff_dir="$HOME/Library/Application Support/Firefox/Profiles"
    if [[ -d "$ff_dir" ]]; then
        local checked_ff=false
        while IFS= read -r prefs; do
            if ! grep -qE 'toolkit\.telemetry\.enabled.*false' "$prefs" 2>/dev/null; then
                if ! $checked_ff; then
                    TELEMETRY_ISSUES=$((TELEMETRY_ISSUES + 1))
                    TELEMETRY_LIST+=("Firefox telemetry enabled")
                    checked_ff=true
                fi
            fi
        done < <(find "$ff_dir" -name "prefs.js" 2>/dev/null | head -3)
    fi

    # Chrome usage stats (Linux)
    local chrome_prefs="$HOME/.config/google-chrome/Default/Preferences"
    [[ "$OS_TYPE" == "macos" ]] && chrome_prefs="$HOME/Library/Application Support/Google/Chrome/Default/Preferences"
    if [[ -f "$chrome_prefs" ]]; then
        if grep -qE '"metrics_reporting".*true|"usage_stats".*true' "$chrome_prefs" 2>/dev/null; then
            TELEMETRY_ISSUES=$((TELEMETRY_ISSUES + 1))
            TELEMETRY_LIST+=("Chrome usage stats reporting enabled")
        fi
    fi

    [[ "$TELEMETRY_ISSUES" -eq 0 ]]
}

check_mac_randomization() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check NetworkManager config for MAC randomization
        local nm_conf="/etc/NetworkManager/NetworkManager.conf"
        local nm_conf_d="/etc/NetworkManager/conf.d"

        local has_rand=false
        # Check main config
        if [[ -f "$nm_conf" ]]; then
            if grep -qE 'wifi\.scan-rand-mac-address\s*=\s*yes' "$nm_conf" 2>/dev/null; then
                has_rand=true
            fi
        fi
        # Check conf.d
        if [[ -d "$nm_conf_d" ]]; then
            while IFS= read -r conf; do
                if grep -qE 'wifi\.scan-rand-mac-address\s*=\s*yes|wifi\.cloned-mac-address\s*=\s*(random|stable)' "$conf" 2>/dev/null; then
                    has_rand=true
                fi
            done < <(find "$nm_conf_d" -name "*.conf" 2>/dev/null)
        fi

        # Also check per-connection configs
        if ! $has_rand && [[ -d "/etc/NetworkManager/system-connections" ]]; then
            # If none of the configs enable it, it's disabled
            return 1
        fi
        $has_rand && return 0 || return 1
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS 14+ has private WiFi addresses on by default
        # Check via networksetup
        if command -v networksetup &>/dev/null; then
            # On modern macOS this is generally on by default
            return 0
        fi
    fi
    return 0
}

