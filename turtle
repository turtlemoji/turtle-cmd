        npm_outdated=$(echo "$npm_outdated" | tr -d '[:space:]')
        if [[ "$npm_outdated" =~ ^[0-9]+$ ]] && [[ "$npm_outdated" -gt 0 ]]; then
            PKG_VULNS_FOUND=$((PKG_VULNS_FOUND + npm_outdated))
            PKG_VULNS_LIST+=("npm: $npm_outdated outdated global packages")
        fi
    fi

    # pip audit if pip-audit is installed (timeout after 5s)
    if command -v pip-audit &>/dev/null; then
        local pip_vulns
        pip_vulns=$(timeout 5 pip-audit 2>/dev/null | grep -c "^Name" || echo "0")
        pip_vulns=$(echo "$pip_vulns" | tr -d '[:space:]')
        if [[ "$pip_vulns" =~ ^[0-9]+$ ]] && [[ "$pip_vulns" -gt 0 ]]; then
            PKG_VULNS_FOUND=$((PKG_VULNS_FOUND + pip_vulns))
            PKG_VULNS_LIST+=("pip: $pip_vulns vulnerable packages")
        fi
    fi

    [[ "$PKG_VULNS_FOUND" -eq 0 ]]
}

check_arp_protection() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check if arpwatch or arpon is running
        if systemctl is-active arpwatch &>/dev/null 2>&1 || \
           systemctl is-active arpon &>/dev/null 2>&1 || \
           pgrep -x arpwatch &>/dev/null || pgrep -x arpon &>/dev/null; then
            return 0
        fi
        # Check sysctl arp_ignore (1 = reply only if target IP is local)
        local arp_ignore
        arp_ignore=$(cat /proc/sys/net/ipv4/conf/all/arp_ignore 2>/dev/null || echo "0")
        if [[ "$arp_ignore" -ge 1 ]]; then
            return 0
        fi
        return 1
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS doesn't have built-in ARP protection - check for arpwatch via brew
        if command -v arpwatch &>/dev/null; then
            return 0
        fi
        return 1
    fi
    return 0
}

HIBP_BREACHES=0
HIBP_EMAIL=""
HIBP_RESULT=""
declare -a HIBP_EMAILS_CHECKED=()
declare -a HIBP_BREACH_DETAILS=()

check_hibp() {
    HIBP_BREACHES=0
    HIBP_EMAIL=""
    HIBP_RESULT=""
    HIBP_EMAILS_CHECKED=()
    HIBP_BREACH_DETAILS=()

    # Collect unique emails from multiple sources
    local seen="" emails=()

    _add_email() {
        local e="$1"
        [[ -z "$e" ]] && return
        # Dedup: check if already seen (space-separated list)
        case " $seen " in *" $e "*) return ;; esac
        emails+=("$e")
        seen="$seen $e"
    }

    # 1. Git global config
    _add_email "$(git config --global user.email 2>/dev/null || echo "")"

    # 2. SSH public key comments (often contain emails)
    for pubkey in "$HOME"/.ssh/*.pub; do
        [[ -f "$pubkey" ]] || continue
        local comment
        comment=$(awk '{print $NF}' "$pubkey" 2>/dev/null || echo "")
        [[ "$comment" == *@*.* ]] && _add_email "$comment"
    done

    # 3. Git repo-level emails (check a few recent repos)
    while IFS= read -r gitconfig; do
        _add_email "$(git config -f "$gitconfig" user.email 2>/dev/null || echo "")"
    done < <(find "$HOME" -maxdepth 4 -path "*/.git/config" -not -path "*/node_modules/*" 2>/dev/null | head -5)

    [[ ${#emails[@]} -eq 0 ]] && return 0

    # Set primary email for display
    HIBP_EMAIL="${emails[0]}"

    # Check each email against XposedOrNot free API
    local total_breaches=0
    for email in "${emails[@]}"; do
        HIBP_EMAILS_CHECKED+=("$email")
        local response http_code
        http_code=$(timeout 8 curl -s -o /tmp/.turtle_hibp_resp -w "%{http_code}" \
            "https://api.xposedornot.com/v1/check-email/${email}" 2>/dev/null || echo "000")

        if [[ "$http_code" == "200" ]]; then
            response=$(cat /tmp/.turtle_hibp_resp 2>/dev/null || echo "")
            rm -f /tmp/.turtle_hibp_resp
            if echo "$response" | grep -q '"breaches"' 2>/dev/null; then
                local count
                count=$(echo "$response" | grep -o '"[^"]*"' | grep -v -E '"(breaches|Error)"' | wc -l | tr -d ' ')
                count=${count:-0}
                if [[ "$count" -gt 0 ]]; then
                    total_breaches=$((total_breaches + count))
                    HIBP_BREACH_DETAILS+=("$email: $count breach(es)")
                fi
            fi
        elif [[ "$http_code" != "404" ]]; then
            rm -f /tmp/.turtle_hibp_resp
            HIBP_BREACH_DETAILS+=("$email: check manually at haveibeenpwned.com")
        else
            rm -f /tmp/.turtle_hibp_resp
        fi
    done

    HIBP_BREACHES=$total_breaches
    if [[ "$total_breaches" -gt 0 ]]; then
        HIBP_RESULT="found in $total_breaches breach(es) across ${#HIBP_BREACH_DETAILS[@]} email(s)"
    else
        HIBP_RESULT="no breaches found (${#emails[@]} email(s) checked)"
    fi

    [[ "$HIBP_BREACHES" -eq 0 ]]
}

PUBLIC_PORTS_EXPOSED=0
declare -a PUBLIC_PORTS_LIST=()

check_public_ports() {
    PUBLIC_PORTS_EXPOSED=0
    PUBLIC_PORTS_LIST=()

    # Get public IP
    local public_ip
    public_ip=$(timeout 5 curl -s https://api.ipify.org 2>/dev/null || echo "")
    [[ -z "$public_ip" ]] && return 0

    # Check common dangerous ports with strict timeout per port
    # Use nc (netcat) if available, otherwise skip (dev/tcp hangs on filtered ports)
    local check_ports=(22 80 443 3389 8080)
    local port_names=("SSH" "HTTP" "HTTPS" "RDP" "HTTP-Alt")

    if command -v nc &>/dev/null; then
        for i in "${!check_ports[@]}"; do
            local port="${check_ports[$i]}"
            local name="${port_names[$i]}"
            if timeout 2 nc -z -w1 "$public_ip" "$port" 2>/dev/null; then
                PUBLIC_PORTS_EXPOSED=$((PUBLIC_PORTS_EXPOSED + 1))
                PUBLIC_PORTS_LIST+=("$name ($port) reachable from internet")
            fi
        done
    elif command -v nmap &>/dev/null; then
        # Fast nmap scan of key ports
        local open_ports
        open_ports=$(timeout 15 nmap -Pn -p22,80,443,3389,8080 --open -oG - "$public_ip" 2>/dev/null | grep "Ports:" || echo "")
        for i in "${!check_ports[@]}"; do
            local port="${check_ports[$i]}"
            local name="${port_names[$i]}"
            if echo "$open_ports" | grep -q "${port}/open" 2>/dev/null; then
                PUBLIC_PORTS_EXPOSED=$((PUBLIC_PORTS_EXPOSED + 1))
                PUBLIC_PORTS_LIST+=("$name ($port) reachable from internet")
            fi
        done
    fi
    # If neither nc nor nmap available, silently skip

    [[ "$PUBLIC_PORTS_EXPOSED" -eq 0 ]]
}

ROOTKIT_INDICATORS=0
declare -a ROOTKIT_LIST=()

check_rootkit_indicators() {
    ROOTKIT_INDICATORS=0
    ROOTKIT_LIST=()

    if [[ "$OS_TYPE" != "linux" ]]; then
        return 0
    fi

    # 1. Check /etc/ld.so.preload (LD_PRELOAD hijacking)
    if [[ -f /etc/ld.so.preload ]] && [[ -s /etc/ld.so.preload ]]; then
        ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
        ROOTKIT_LIST+=("/etc/ld.so.preload exists (LD_PRELOAD hijacking)")
    fi

    # 2. Suspicious kernel modules
    if command -v lsmod &>/dev/null; then
        local suspicious_mods="(diamorphine|reptile|suterusu|adore|knark|rial|heroin|override|hiding)"
        local bad_mods
        bad_mods=$(lsmod 2>/dev/null | grep -iE "$suspicious_mods" | awk '{print $1}' || echo "")
        if [[ -n "$bad_mods" ]]; then
            while IFS= read -r mod; do
                ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
                ROOTKIT_LIST+=("Suspicious kernel module: $mod")
            done <<< "$bad_mods"
        fi
    fi

    # 3. Executables in /dev/shm (common staging area for malware)
    local shm_execs
    shm_execs=$(find /dev/shm -type f -executable 2>/dev/null | head -5)
    if [[ -n "$shm_execs" ]]; then
        while IFS= read -r exe; do
            ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
            ROOTKIT_LIST+=("Executable in /dev/shm: $exe")
        done <<< "$shm_execs"
    fi

    # 4. Hidden process detection: compare /proc count vs ps count
    if [[ -d /proc ]]; then
        local proc_count ps_count
        proc_count=$(ls -1d /proc/[0-9]* 2>/dev/null | wc -l)
        ps_count=$(ps -e --no-headers 2>/dev/null | wc -l || echo "$proc_count")
        local diff=$((proc_count - ps_count))
        # Allow small difference (race condition), flag if > 5
        if [[ "$diff" -gt 5 ]] || [[ "$diff" -lt -5 ]]; then
            ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
            ROOTKIT_LIST+=("Process count mismatch: /proc=$proc_count vs ps=$ps_count (hidden processes?)")
        fi
    fi

    # 5. Check for modified package binaries (quick check on a few critical ones)
    if command -v rpm &>/dev/null; then
        local tampered
        tampered=$(rpm -Va 2>/dev/null | grep -E "^..5" | grep -E "(bin/|sbin/)" | head -3 || echo "")
        if [[ -n "$tampered" ]]; then
            while IFS= read -r line; do
                ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
                ROOTKIT_LIST+=("Modified binary: $line")
            done <<< "$tampered"
        fi
    elif command -v debsums &>/dev/null; then
        local tampered
        tampered=$(timeout 10 debsums -s 2>/dev/null | grep -E "(bin/|sbin/)" | head -3 || echo "")
        if [[ -n "$tampered" ]]; then
            while IFS= read -r line; do
                ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
                ROOTKIT_LIST+=("Modified binary: $line")
            done <<< "$tampered"
        fi
    fi

    # 6. Suspicious SUID binaries in unusual locations
    local sus_suid
    sus_suid=$(find /tmp /var/tmp /dev/shm "$HOME" -perm -4000 -type f 2>/dev/null | head -5)
    if [[ -n "$sus_suid" ]]; then
        while IFS= read -r suid; do
            ROOTKIT_INDICATORS=$((ROOTKIT_INDICATORS + 1))
            ROOTKIT_LIST+=("SUID binary in unusual location: $suid")
        done <<< "$sus_suid"
    fi

    [[ "$ROOTKIT_INDICATORS" -eq 0 ]]
}

run_advanced_checks() {
    local category="ADVANCED"

    # ARP spoofing protection
    animate_turtle "Checking ARP protection"
    run_check "$category" "ARP spoofing protection" 25 "check_arp_protection" || true

    # Have I Been Pwned
    animate_turtle "Checking breach databases"
    check_hibp || true
    if [[ ${#HIBP_EMAILS_CHECKED[@]} -gt 0 ]]; then
        local email_list
        email_list=$(printf "%s, " "${HIBP_EMAILS_CHECKED[@]}")
        email_list="${email_list%, }"
        if [[ "$HIBP_BREACHES" -eq 0 ]]; then
            record_check "$category" "No breaches found ($email_list)" "1" "0" "0"
        else
            record_check "$category" "!! $HIBP_BREACHES breach(es) found ($email_list)" "0" "0" "0"
        fi
    fi

    # Publicly exposed ports
    animate_turtle "Checking public port exposure"
    check_public_ports || true
    add_max 50
    if [[ "$PUBLIC_PORTS_EXPOSED" -eq 0 ]]; then
        record_check "$category" "No ports exposed to internet" "1" "50" "50"
        add_score 50
    else
        local penalty=$((PUBLIC_PORTS_EXPOSED * 20))
        [[ $penalty -gt 100 ]] && penalty=100
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "!! Ports exposed to internet: $PUBLIC_PORTS_EXPOSED" "0" "-$penalty" "50"
    fi

    # Rootkit indicators
    animate_turtle "Checking for rootkit indicators"
    check_rootkit_indicators || true
    add_max 100
    if [[ "$ROOTKIT_INDICATORS" -eq 0 ]]; then
        record_check "$category" "No rootkit indicators" "1" "100" "100"
        add_score 100
    else
        local penalty=$((ROOTKIT_INDICATORS * 50))
        [[ $penalty -gt 500 ]] && penalty=500
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "!! ROOTKIT INDICATORS: $ROOTKIT_INDICATORS" "0" "-$penalty" "100"
    fi
}

