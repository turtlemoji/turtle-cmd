        record_check "$category" "!! Password vault bad perms: $VAULT_ISSUES" "0" "-25" "0"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# HIGH IMPACT CHECKS - Helper functions
# ═══════════════════════════════════════════════════════════════════════════════

SECRETS_IN_CONFIG=0
declare -a CONFIG_SECRETS_FOUND=()

check_secrets_in_shell_config() {
    local config_files=("$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.zprofile" "$HOME/.profile")
    local patterns='(export\s+)?(API[_-]?KEY|SECRET[_-]?KEY|AWS_SECRET|TOKEN|PASSWORD|PRIVATE[_-]?KEY)[=]["\x27]?[A-Za-z0-9+/=_-]{8,}'

    SECRETS_IN_CONFIG=0
    CONFIG_SECRETS_FOUND=()
    for cfile in "${config_files[@]}"; do
        if [[ -f "$cfile" ]]; then
            while IFS= read -r line; do
                local redacted
                redacted=$(echo "$line" | sed -E 's/[=]["\x27]?[A-Za-z0-9+/=_-]{8,}/=*****/g' | cut -c1-60)
                CONFIG_SECRETS_FOUND+=("$(basename "$cfile"): $redacted")
                SECRETS_IN_CONFIG=$((SECRETS_IN_CONFIG + 1))
            done < <(grep -E "$patterns" "$cfile" 2>/dev/null | head -5)
        fi
    done
    [[ "$SECRETS_IN_CONFIG" -eq 0 ]]
}

check_git_credential_helper() {
    # Check if git is storing credentials in plaintext
    local helper
    helper=$(git config --global credential.helper 2>/dev/null || echo "")

    # "store" saves in plaintext ~/.git-credentials
    if [[ "$helper" == "store" ]]; then
        return 1
    fi

    # Check if .git-credentials exists with content
    if [[ -f "$HOME/.git-credentials" ]] && [[ -s "$HOME/.git-credentials" ]]; then
        return 1
    fi

    return 0
}

check_ssh_agent_forwarding() {
    # Check if ForwardAgent is enabled by default in ssh config
    if [[ -f "$HOME/.ssh/config" ]]; then
        if grep -qiE "^\s*ForwardAgent\s+yes" "$HOME/.ssh/config" 2>/dev/null; then
            # Check if it's a wildcard/default setting (dangerous)
            if grep -B5 -iE "^\s*ForwardAgent\s+yes" "$HOME/.ssh/config" 2>/dev/null | grep -qiE "^\s*Host\s+\*"; then
                return 1
            fi
        fi
    fi
    return 0
}

check_docker_socket() {
    local socket="/var/run/docker.sock"
    if [[ -S "$socket" ]]; then
        # Check if world-readable/writable
        local perms
        if [[ "$OS_TYPE" == "linux" ]]; then
            perms=$(stat -c %a "$socket" 2>/dev/null)
        else
            perms=$(stat -f %Lp "$socket" 2>/dev/null)
        fi
        # Socket should not be world-accessible (perms like 660 are ok, 666 is bad)
        if [[ "$perms" =~ [2367]$ ]]; then
            return 1
        fi
    fi
    return 0
}

# ═══════════════════════════════════════════════════════════════════════════════
# INFOSTEALER TARGET CHECKS - things malware looks for
# ═══════════════════════════════════════════════════════════════════════════════

# Crypto wallet files on disk
CRYPTO_WALLETS_FOUND=0
declare -a CRYPTO_WALLETS_LIST=()

check_crypto_wallets() {
    CRYPTO_WALLETS_FOUND=0
    CRYPTO_WALLETS_LIST=()

    # Bitcoin Core
    local btc_paths=("$HOME/.bitcoin/wallet.dat" "$HOME/Library/Application Support/Bitcoin/wallet.dat")
    # Electrum
