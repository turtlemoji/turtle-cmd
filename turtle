# ═══════════════════════════════════════════════════════════════════════════════
# COLOR SETUP
# ═══════════════════════════════════════════════════════════════════════════════

setup_colors() {
    if [[ -t 1 ]] && [[ "${NO_COLOR:-}" != "1" ]]; then
        RED='\033[0;31m'
        GREEN='\033[0;32m'
        YELLOW='\033[0;33m'
        BLUE='\033[0;34m'
        MAGENTA='\033[0;35m'
        CYAN='\033[0;36m'
        WHITE='\033[1;37m'
        BOLD='\033[1m'
        DIM='\033[2m'
        RESET='\033[0m'
    else
        RED='' GREEN='' YELLOW='' BLUE='' MAGENTA='' CYAN='' WHITE='' BOLD='' DIM='' RESET=''
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# OS DETECTION
# ═══════════════════════════════════════════════════════════════════════════════

detect_os() {
    OS="$(uname -s)"
    case "$OS" in
        Linux)  OS_TYPE="linux" ;;
        Darwin) OS_TYPE="macos" ;;
        *)      OS_TYPE="unknown" ;;
    esac

    # macOS doesn't have timeout (GNU coreutils)
    if ! command -v timeout &>/dev/null; then
        if command -v gtimeout &>/dev/null; then
            timeout() { gtimeout "$@"; }
        else
            # Use perl's alarm() as timeout - perl is always on macOS
            timeout() { command perl -e 'alarm shift; exec @ARGV' "$@"; }
        fi
    fi
}

