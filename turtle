check_password_manager() {
    # Check for common password managers
    if command -v 1password &>/dev/null || command -v op &>/dev/null; then
        return 0  # 1Password
    elif command -v bw &>/dev/null; then
        return 0  # Bitwarden CLI
    elif command -v keepassxc-cli &>/dev/null || command -v keepassxc &>/dev/null; then
        return 0  # KeePassXC
    elif command -v pass &>/dev/null; then
        return 0  # pass (Unix password store)
    elif command -v lpass &>/dev/null; then
        return 0  # LastPass CLI
    fi

    # Check for GUI password managers
    if [[ "$OS_TYPE" == "linux" ]]; then
        if command -v seahorse &>/dev/null || command -v gnome-keyring &>/dev/null; then
            return 0  # GNOME Keyring
        fi
        # Check for flatpak/snap password managers
        flatpak list 2>/dev/null | grep -qi "bitwarden\|1password\|keepass" && return 0
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS Keychain is always available
        if [[ -d "/Applications/1Password.app" ]] || \
           [[ -d "/Applications/Bitwarden.app" ]] || \
           [[ -d "/Applications/KeePassXC.app" ]]; then
            return 0
        fi
        # macOS Keychain counts
        return 0
    fi

    return 1
}

check_git_signing() {
    # Check if git commit signing is configured
    local signing
    signing=$(git config --global commit.gpgsign 2>/dev/null || echo "false")
    [[ "$signing" == "true" ]]
}

check_pending_security_updates() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        if command -v apt &>/dev/null; then
            # Debian/Ubuntu - check for security updates
            local sec_updates
            sec_updates=$(apt list --upgradable 2>/dev/null | grep -ci "security" || echo "0")
            [[ "$sec_updates" -lt 5 ]]
        elif command -v dnf &>/dev/null; then
            local sec_updates
            sec_updates=$(dnf check-update --security 2>/dev/null | grep -c "\.x86_64\|\.noarch\|\.aarch64" || echo "0")
            [[ "$sec_updates" -lt 5 ]]
        elif command -v pacman &>/dev/null; then
            # Arch - check if system is up to date
            local pending
            pending=$(pacman -Qu 2>/dev/null | wc -l | tr -d ' ')
            [[ "$pending" -lt 20 ]]
        else
            return 0
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        local pending
        pending=$(softwareupdate -l 2>&1 | grep -c "recommended" || echo "0")
        [[ "$pending" -lt 3 ]]
    else
        return 0
    fi
}

check_swap_encryption() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check if swap is encrypted or doesn't exist
        local swap_devices
        swap_devices=$(swapon --show=NAME --noheadings 2>/dev/null)
        if [[ -z "$swap_devices" ]]; then
            return 0  # No swap, no problem
        fi
        # Check if swap is on an encrypted device
        while IFS= read -r swap; do
            if [[ "$swap" == /dev/mapper/* ]] || [[ "$swap" == /dev/dm-* ]]; then
                continue  # Encrypted (dm-crypt/LUKS)
            fi
            # Check if it's a zram device (compressed RAM, not on disk)
            if [[ "$swap" == /dev/zram* ]]; then
                continue  # zram is fine
            fi
            # Unencrypted swap on disk
            return 1
        done <<< "$swap_devices"
        return 0
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS encrypts swap by default when FileVault is on
        if fdesetup status 2>/dev/null | grep -q "On"; then
            return 0
        fi
        # Check sysctl for encrypted swap
        sysctl vm.swapusage 2>/dev/null | grep -q "encrypted" && return 0
        return 1
    fi
    return 0
}

check_kernel_up_to_date() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        local running installed
        running=$(uname -r)
        # Check what kernel is installed vs running
        if command -v rpm &>/dev/null; then
            installed=$(rpm -q kernel --last 2>/dev/null | head -1 | awk '{print $1}' | sed 's/kernel-//')
        elif [[ -d /boot ]]; then
            installed=$(ls -t /boot/vmlinuz-* 2>/dev/null | head -1 | sed 's|.*/vmlinuz-||')
        else
            return 0
        fi
        # If we can determine the installed kernel, compare
        if [[ -n "$installed" ]]; then
            [[ "$running" == "$installed" ]]
        else
            return 0
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS kernel is updated with system updates
        # Check if there are pending system updates
        local pending
        pending=$(softwareupdate -l 2>&1 | grep -ci "restart" || echo "0")
        [[ "$pending" -eq 0 ]]
    else
        return 0
    fi
}

run_bestpractice_checks() {
    local category="BEST PRACTICES"

    run_check "$category" "Password manager installed" 50 "check_password_manager" || true
    run_check "$category" "Git commit signing enabled" 25 "check_git_signing" || true
    run_check "$category" "Security updates applied" 75 "check_pending_security_updates" || true
    run_check "$category" "Swap encrypted" 50 "check_swap_encryption" || true
    run_check "$category" "Kernel up to date" 50 "check_kernel_up_to_date" || true

    # SSH key audit
    animate_turtle "Auditing SSH keys"
    check_ssh_key_audit || true
    add_max 50
    if [[ "$SSH_KEY_ISSUES" -eq 0 ]]; then
        record_check "$category" "SSH keys use strong algorithms" "1" "50" "50"
        add_score 50
    else
        local penalty=$((SSH_KEY_ISSUES * 15))
        [[ $penalty -gt 75 ]] && penalty=75
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "SSH key issues: $SSH_KEY_ISSUES" "0" "-$penalty" "50"
    fi

    # Unencrypted backup drives
    animate_turtle "Checking backup encryption"
    run_check "$category" "Backup drives encrypted" 50 "check_unencrypted_backups" || true

    # npm/pip global package vulnerabilities
    animate_turtle "Checking package vulnerabilities"
    check_package_vulns || true
    if [[ "$PKG_VULNS_FOUND" -gt 0 ]]; then
        record_check "$category" "Package vulns found: $PKG_VULNS_FOUND" "skip" "0" "0"
    fi
}

