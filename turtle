check_hostname_privacy() {
    local hn
    hn=$(hostname 2>/dev/null || cat /etc/hostname 2>/dev/null || echo "")
    [[ -z "$hn" ]] && return 0

    # Common patterns that reveal personal info
    local hn_lower
    hn_lower=$(echo "$hn" | tr '[:upper:]' '[:lower:]')

    # Check for name-like patterns: FirstName-PC, John-MacBook-Pro, etc.
    if [[ "$hn_lower" =~ (macbook|imac|ipad|iphone) ]]; then
        HOSTNAME_ISSUE="$hn (reveals device type)"
        return 1
    fi
    # Check for firstname-lastname patterns
    if [[ "$hn_lower" =~ ^[a-z]+-[a-z]+(-(pc|laptop|desktop|macbook|pro|air))?$ ]]; then
        HOSTNAME_ISSUE="$hn (may reveal name)"
        return 1
    fi
    # Check for name's patterns: johns-macbook-pro
    if [[ "$hn_lower" =~ s-(macbook|mbp|laptop|pc|desktop|imac) ]]; then
        HOSTNAME_ISSUE="$hn (reveals owner name)"
        return 1
    fi
    HOSTNAME_ISSUE=""
    return 0
}

check_login_banner() {
    # Check if /etc/issue or /etc/issue.net leak OS info
    if [[ "$OS_TYPE" == "linux" ]]; then
        for banner_file in /etc/issue /etc/issue.net; do
            if [[ -f "$banner_file" ]] && [[ -s "$banner_file" ]]; then
                # Check if it contains OS/kernel version info
                if grep -qEi '(ubuntu|debian|fedora|centos|arch|kernel|\\r|\\v|\\s|\\m)' "$banner_file" 2>/dev/null; then
                    return 1
                fi
            fi
        done
    fi
    # Check SSH banner directive
    if [[ -f /etc/ssh/sshd_config ]]; then
        if grep -qE '^\s*Banner\s+' /etc/ssh/sshd_config 2>/dev/null; then
            local banner_path
            banner_path=$(grep -E '^\s*Banner\s+' /etc/ssh/sshd_config 2>/dev/null | awk '{print $2}')
            if [[ -f "$banner_path" ]] && [[ "$banner_path" != "none" ]]; then
                if grep -qEi '(ubuntu|debian|fedora|centos|arch|kernel|version)' "$banner_path" 2>/dev/null; then
                    return 1
                fi
            fi
        fi
    fi
    return 0
}

TELEMETRY_ISSUES=0
