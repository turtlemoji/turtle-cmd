main() {
    local json_output=false
    local quiet=false

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            update)
                local self
                self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || realpath "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
                local repo="https://raw.githubusercontent.com/turtlemoji/turtle-cmd/main/turtle"

                # Check we can write to the install location
                if [[ ! -w "$self" ]]; then
                    echo "Error: No write permission to $self"
                    echo "Try: sudo turtle update"
                    exit 1
                fi

                echo "Checking for updates..."

                # Download to temp file
                local tmp
                tmp="$(mktemp)"
                if ! curl -fsSL "$repo" -o "$tmp" 2>/dev/null; then
                    rm -f "$tmp"
                    echo "Error: Failed to download update"
                    exit 1
                fi

                # Compare versions
                local new_ver
                new_ver=$(grep '^VERSION=' "$tmp" | cut -d'"' -f2)

                if [[ "$new_ver" == "$VERSION" ]]; then
                    rm -f "$tmp"
                    echo "🐢 Already up to date (v${VERSION})"
                    exit 0
                fi

                # Replace
                mv "$tmp" "$self"
                chmod +x "$self"
                echo "🐢 Updated v${VERSION} → v${new_ver}"
                exit 0
                ;;
            -h|--help)
                print_help
                exit 0
                ;;
            -v|--version)
                echo "turtle v${VERSION}"
                exit 0
                ;;
            -j|--json)
                json_output=true
                shift
                ;;
            -q|--quiet)
                quiet=true
                shift
                ;;
            --no-color)
                NO_COLOR=1
                shift
                ;;
            *)
                echo "Unknown option: $1"
                echo "Use --help for usage information"
                exit 1
                ;;
        esac
    done

    # Setup
    setup_colors
    detect_os

    if [[ "$OS_TYPE" == "unknown" ]]; then
        echo -e "${RED}Error: Unsupported operating system${RESET}"
        exit 1
    fi

    # Suppress animation for JSON output
    [[ "$json_output" == "true" ]] && quiet=true

    SCAN_START=$SECONDS

    # Start animation or print static header
    if [[ "$quiet" != "true" ]]; then
        start_animation
    elif [[ "$json_output" != "true" ]]; then
        print_header
    fi

    # Run all checks
    run_system_checks
    run_ssh_checks
    run_user_checks
    run_filesystem_checks
    run_secrets_checks
    run_network_checks
    run_services_checks
    run_hardening_checks
    run_bestpractice_checks
    run_privacy_checks
    run_advanced_checks

    # Stop animation
    [[ "$quiet" != "true" ]] && stop_animation

    # Output results
    if [[ "$json_output" == "true" ]]; then
        print_json_output
    else
        # Print header with turtle after animation
        [[ "$quiet" != "true" ]] && print_header_with_turtle
        [[ "$quiet" == "true" ]] || true  # quiet mode already printed header
        print_results
        print_score
        print_findings
    fi
}

# Cleanup on exit
cleanup() {
    tput cnorm 2>/dev/null || true
}
trap cleanup EXIT

# Run main
main "$@"
