# Bottom spinner for check status
SPINNER_FRAMES=("⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏")
SPINNER_IDX=0

draw_turtle_frame() {
    local frame_num=$1
    local msg="$2"

    # Move cursor to top
    tput cup 0 0 2>/dev/null || printf "\033[H"

    # Print header
    echo -e "${GREEN}${BOLD}🐢 TURTLE SECURITY SCANNER 🐢${RESET} v${VERSION}"
    echo -e "${DIM}════════════════════════════════════════${RESET}"

    # Color the frame based on type for extra hackiness
    local frame_color="$CYAN"
    case $frame_num in
        1|2)   frame_color="$GREEN" ;;   # matrix rain = green
        3|5|8) frame_color="$YELLOW" ;;  # scanning/probing = yellow
        4)     frame_color="$BLUE" ;;    # binary = blue
        6)     frame_color="$MAGENTA" ;; # hex dump = magenta
        7)     frame_color="$RED" ;;     # glitch = red
        9)     frame_color="$GREEN" ;;   # results = green
    esac

    echo -e "${frame_color}${TURTLE_FRAMES_BIG[$frame_num]}${RESET}"

    # Move to status line (after turtle art)
    tput cup 14 0 2>/dev/null || printf "\033[15;0H"

    # Show spinner and current check
    local spinner="${SPINNER_FRAMES[$SPINNER_IDX]}"
    local width
    width=$(tput cols 2>/dev/null || echo 80)
    printf "%${width}s\r" ""
    printf "  ${GREEN}%s${RESET} ${CYAN}%s${RESET}" "$spinner" "$msg"

    SPINNER_IDX=$(( (SPINNER_IDX + 1) % ${#SPINNER_FRAMES[@]} ))
}

animate_turtle() {
    local msg="$1"
    if [[ "$ANIMATION_RUNNING" == "true" ]]; then
        # Animate turtle with hacker effects
        for _ in {1..3}; do
            draw_turtle_frame $TURTLE_IDX "$msg"
            TURTLE_IDX=$(( (TURTLE_IDX + 1) % 10 ))
            sleep 0.15
        done
    fi
}

start_animation() {
    ANIMATION_RUNNING=true
    TURTLE_IDX=0
    SPINNER_IDX=0
    init_turtle_frames
    tput civis 2>/dev/null || true
    clear
}

stop_animation() {
    ANIMATION_RUNNING=false
    tput cnorm 2>/dev/null || true
    clear
}

# ═══════════════════════════════════════════════════════════════════════════════
# SCORING SYSTEM
# ═══════════════════════════════════════════════════════════════════════════════

TOTAL_SCORE=0
MAX_SCORE=0
CHECKS_PASSED=0
CHECKS_FAILED=0
CHECKS_SKIPPED=0
SCAN_START=0
declare -a CHECK_RESULTS=()
declare -a SKIPPED_SUDO=()

# Check if we have root/sudo access
is_root() {
    [[ $EUID -eq 0 ]]
}

can_read_shadow() {
    [[ -r /etc/shadow ]]
}

can_read_sudoers() {
    [[ -r /etc/sudoers ]]
}

add_score() {
    local points="$1"
    TOTAL_SCORE=$((TOTAL_SCORE + points))
}

add_max() {
    local points="$1"
    MAX_SCORE=$((MAX_SCORE + points))
}

record_check() {
    local category="$1"
    local name="$2"
    local passed="$3"
    local points="$4"
    local max_points="$5"

    CHECK_RESULTS+=("$category|$name|$passed|$points|$max_points")

    if [[ "$passed" == "1" ]]; then
        CHECKS_PASSED=$((CHECKS_PASSED + 1))
    elif [[ "$passed" == "skip" ]]; then
        CHECKS_SKIPPED=$((CHECKS_SKIPPED + 1))
    else
        CHECKS_FAILED=$((CHECKS_FAILED + 1))
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# CHECK FRAMEWORK
# ═══════════════════════════════════════════════════════════════════════════════

run_check() {
    local category="$1"
    local name="$2"
    local max_points="$3"
    local check_cmd="$4"

    animate_turtle "$name"

    add_max "$max_points"

    if eval "$check_cmd" >/dev/null 2>&1; then
        add_score "$max_points"
        record_check "$category" "$name" "1" "$max_points" "$max_points"
        return 0
    else
        record_check "$category" "$name" "0" "0" "$max_points"
        return 1
    fi
}

skip_check() {
    local category="$1"
    local name="$2"
    local reason="$3"

    record_check "$category" "$name (skipped: $reason)" "skip" "0" "0"
}

# ═══════════════════════════════════════════════════════════════════════════════
# SYSTEM SECURITY CHECKS (max ~300 pts)
# ═══════════════════════════════════════════════════════════════════════════════

FIREWALL_NEEDS_SUDO=false

check_firewall() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check ufw first, then iptables/nftables
        if command -v ufw &>/dev/null; then
            # ufw needs root to check status
            if is_root; then
                ufw status 2>/dev/null | grep -q "Status: active"
            else
                # Check if ufw service is running without root
                systemctl is-active ufw &>/dev/null || \
                    systemctl is-active ufw.service &>/dev/null || \
                    { FIREWALL_NEEDS_SUDO=true; return 1; }
            fi
        elif command -v nft &>/dev/null; then
            [[ $(nft list ruleset 2>/dev/null | wc -l) -gt 0 ]]
        elif command -v iptables &>/dev/null; then
            [[ $(iptables -L -n 2>/dev/null | wc -l) -gt 8 ]]
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        /usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2>/dev/null | grep -q "enabled"
    else
        return 1
    fi
}

check_auto_updates() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for unattended-upgrades on Debian/Ubuntu
        if [[ -f /etc/apt/apt.conf.d/20auto-upgrades ]]; then
            grep -q 'APT::Periodic::Update-Package-Lists "1"' /etc/apt/apt.conf.d/20auto-upgrades 2>/dev/null
        # Check for dnf-automatic on Fedora/RHEL
        elif systemctl is-enabled dnf-automatic.timer &>/dev/null; then
            return 0
        # Check for yum-cron
        elif systemctl is-enabled yum-cron &>/dev/null; then
            return 0
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        defaults read /Library/Preferences/com.apple.SoftwareUpdate AutomaticCheckEnabled 2>/dev/null | grep -q "1"
    else
        return 1
    fi
}

check_sip_selinux() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check SELinux
        if command -v getenforce &>/dev/null; then
            [[ "$(getenforce 2>/dev/null)" == "Enforcing" ]]
        # Check AppArmor
        elif command -v aa-status &>/dev/null; then
            aa-status --enabled 2>/dev/null
        elif [[ -d /sys/kernel/security/apparmor ]]; then
            return 0
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        csrutil status 2>/dev/null | grep -q "enabled"
    else
        return 1
    fi
}

check_disk_encryption() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for LUKS encrypted partitions
        if command -v lsblk &>/dev/null; then
            lsblk -o TYPE 2>/dev/null | grep -q "crypt"
        elif [[ -d /sys/class/block ]]; then
            ls /dev/mapper/*crypt* &>/dev/null || dmsetup status 2>/dev/null | grep -q "crypt"
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        fdesetup status 2>/dev/null | grep -q "On"
    else
        return 1
    fi
}

check_secure_boot() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        if [[ -d /sys/firmware/efi ]]; then
            # Check if secure boot is enabled
            if [[ -f /sys/firmware/efi/efivars/SecureBoot-* ]] 2>/dev/null; then
                # Read the secure boot variable
                local sb_file
                sb_file=$(ls /sys/firmware/efi/efivars/SecureBoot-* 2>/dev/null | head -1)
                if [[ -n "$sb_file" ]]; then
                    # Last byte indicates status (1 = enabled)
                    [[ $(od -An -t u1 "$sb_file" 2>/dev/null | awk '{print $NF}') -eq 1 ]]
                else
                    return 1
                fi
            elif command -v mokutil &>/dev/null; then
                mokutil --sb-state 2>/dev/null | grep -q "SecureBoot enabled"
            else
                return 1
            fi
        else
            return 1  # Not UEFI system
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # macOS T2/Apple Silicon always has secure boot
        if [[ "$(uname -m)" == "arm64" ]]; then
            return 0
        elif system_profiler SPiBridgeDataType 2>/dev/null | grep -q "T2"; then
            return 0
        else
            return 1
        fi
    else
        return 1
    fi
}

run_system_checks() {
    local category="SYSTEM SECURITY"

    run_check "$category" "Firewall enabled" 100 "check_firewall" || true
    if [[ "$FIREWALL_NEEDS_SUDO" == "true" ]]; then
        # Undo the failed check and replace with skip
        unset 'CHECK_RESULTS[-1]'
        CHECKS_FAILED=$((CHECKS_FAILED - 1))
        MAX_SCORE=$((MAX_SCORE - 100))
        skip_check "$category" "Firewall check" "needs sudo"
        SKIPPED_SUDO+=("Firewall check (ufw needs root)")
    fi
    run_check "$category" "Auto-updates configured" 50 "check_auto_updates" || true

    if [[ "$OS_TYPE" == "macos" ]]; then
        run_check "$category" "SIP enabled" 75 "check_sip_selinux" || true
    else
        run_check "$category" "SELinux/AppArmor active" 75 "check_sip_selinux" || true
    fi

    run_check "$category" "Disk encryption enabled" 100 "check_disk_encryption" || true
    run_check "$category" "Secure boot enabled" 50 "check_secure_boot" || true
}

# ═══════════════════════════════════════════════════════════════════════════════
# SSH SECURITY CHECKS (max ~250 pts)
# ═══════════════════════════════════════════════════════════════════════════════

get_sshd_config() {
    # Output main config
    [[ -f /etc/ssh/sshd_config ]] && cat /etc/ssh/sshd_config 2>/dev/null

    # Include any config.d files
    if [[ -d /etc/ssh/sshd_config.d ]]; then
        for f in /etc/ssh/sshd_config.d/*.conf; do
            [[ -f "$f" ]] && cat "$f" 2>/dev/null
        done
    fi
}

check_ssh_root_login() {
    if [[ ! -f /etc/ssh/sshd_config ]]; then
        return 1  # SSH not installed
    fi
    # PermitRootLogin should be "no" or "prohibit-password"
    get_sshd_config | grep -Ei "^PermitRootLogin\s+(no|prohibit-password)" &>/dev/null
}

check_ssh_password_auth() {
    if [[ ! -f /etc/ssh/sshd_config ]]; then
        return 1
    fi
    get_sshd_config | grep -Ei "^PasswordAuthentication\s+no" &>/dev/null
}

check_ssh_non_standard_port() {
    if [[ ! -f /etc/ssh/sshd_config ]]; then
        return 1
    fi
    local port
    port=$(get_sshd_config | grep -Ei "^Port\s+" | awk '{print $2}' | head -1)
    [[ -n "$port" && "$port" != "22" ]]
}

check_ssh_root_authorized_keys() {
    # Pass if root has no authorized_keys or it's empty
    if [[ -f /root/.ssh/authorized_keys ]]; then
        [[ ! -s /root/.ssh/authorized_keys ]]
    else
        return 0
    fi
}

check_ssh_protocol() {
    if [[ ! -f /etc/ssh/sshd_config ]]; then
        return 1
    fi
    # Modern OpenSSH defaults to protocol 2, so no explicit Protocol line is fine
    # Fail only if explicitly set to 1
    ! get_sshd_config | grep -Ei "^Protocol\s+1" &>/dev/null
}

run_ssh_checks() {
    local category="SSH SECURITY"

    if [[ ! -f /etc/ssh/sshd_config ]]; then
        skip_check "$category" "SSH checks" "SSH not installed"
        return
    fi

    run_check "$category" "SSH root login disabled" 75 "check_ssh_root_login" || true
    run_check "$category" "SSH password auth disabled" 75 "check_ssh_password_auth" || true
    run_check "$category" "SSH non-standard port" 25 "check_ssh_non_standard_port" || true
    run_check "$category" "No root authorized_keys" 50 "check_ssh_root_authorized_keys" || true
    run_check "$category" "SSH protocol 2 only" 25 "check_ssh_protocol" || true
}

# ═══════════════════════════════════════════════════════════════════════════════
# USER SECURITY CHECKS (max ~250 pts)
# ═══════════════════════════════════════════════════════════════════════════════

check_user_has_password() {
    local user
    user=$(whoami)
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check if user has a password set (not empty or locked)
        local passwd_entry
        passwd_entry=$(sudo getent shadow "$user" 2>/dev/null || grep "^$user:" /etc/shadow 2>/dev/null)
        if [[ -n "$passwd_entry" ]]; then
            local hash
            hash=$(echo "$passwd_entry" | cut -d: -f2)
            # Password is set if hash doesn't start with ! or * and isn't empty
            [[ -n "$hash" && "$hash" != "!" && "$hash" != "*" && "$hash" != "!!" ]]
        else
            return 1
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # On macOS, check if user account has password enabled
        dscl . -read /Users/"$user" AuthenticationAuthority 2>/dev/null | grep -q "ShadowHash"
    else
        return 1
    fi
}

check_no_empty_passwords() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for empty password fields in shadow
        if [[ -r /etc/shadow ]]; then
            ! awk -F: '($2 == "" || $2 == "!") {exit 1}' /etc/shadow 2>/dev/null
            # Actually, we want NO empty passwords, so:
            ! grep -E '^[^:]+::' /etc/shadow 2>/dev/null
        else
            return 0  # Can't read shadow, assume secure
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check all users
        local users
        users=$(dscl . -list /Users | grep -v "^_")
        for u in $users; do
            if dscl . -read /Users/"$u" Password 2>/dev/null | grep -q '^\*$'; then
                continue  # System account
            fi
        done
        return 0
    else
        return 1
    fi
}

check_sudo_requires_password() {
    # Check if NOPASSWD: ALL is set (dangerous - full sudo without password)
    # NOPASSWD for specific commands is acceptable
    if sudo -l 2>/dev/null | grep -qE "NOPASSWD:\s*(ALL|/bin/\*|/usr/bin/\*)"; then
        return 1  # NOPASSWD for everything is insecure
    fi
    return 0
}

check_screen_lock() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for common screen lock settings
        if command -v gsettings &>/dev/null; then
            local lock_enabled
            lock_enabled=$(gsettings get org.gnome.desktop.screensaver lock-enabled 2>/dev/null || echo "false")
            [[ "$lock_enabled" == "true" ]]
        elif command -v xfconf-query &>/dev/null; then
            xfconf-query -c xfce4-screensaver -p /lock/enabled 2>/dev/null | grep -q "true"
        else
            # Check if xscreensaver or similar is configured
            [[ -f ~/.xscreensaver ]] && grep -q "lock:.*True" ~/.xscreensaver 2>/dev/null
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check if screen saver password is required
        local ask_password
        ask_password=$(defaults read com.apple.screensaver askForPassword 2>/dev/null || echo "0")
        [[ "$ask_password" == "1" ]]
    else
        return 1
    fi
}

check_guest_disabled() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for guest account in various DMs
        if [[ -f /etc/lightdm/lightdm.conf ]]; then
            grep -q "allow-guest=false" /etc/lightdm/lightdm.conf 2>/dev/null || \
            ! grep -q "allow-guest=true" /etc/lightdm/lightdm.conf 2>/dev/null
        else
            # No guest configuration found, assume disabled
            ! getent passwd guest &>/dev/null
        fi
    elif [[ "$OS_TYPE" == "macos" ]]; then
        local guest_enabled
        guest_enabled=$(defaults read /Library/Preferences/com.apple.loginwindow GuestEnabled 2>/dev/null || echo "0")
        [[ "$guest_enabled" == "0" ]]
    else
        return 1
    fi
}

run_user_checks() {
    local category="USER SECURITY"

    if can_read_shadow || is_root; then
        run_check "$category" "User has password" 50 "check_user_has_password" || true
        run_check "$category" "No empty passwords" 75 "check_no_empty_passwords" || true
    else
        skip_check "$category" "User has password" "needs sudo"
        skip_check "$category" "No empty passwords" "needs sudo"
        SKIPPED_SUDO+=("User password checks (/etc/shadow)")
    fi
    run_check "$category" "Sudo requires password" 50 "check_sudo_requires_password" || true
    run_check "$category" "Screen lock enabled" 50 "check_screen_lock" || true
    run_check "$category" "Guest account disabled" 25 "check_guest_disabled" || true
}

# ═══════════════════════════════════════════════════════════════════════════════
# FILE SYSTEM SECURITY CHECKS (max ~250 pts)
# ═══════════════════════════════════════════════════════════════════════════════

check_no_world_writable_in_path() {
    local found=0
    IFS=':' read -ra path_dirs <<< "$PATH"
    for dir in "${path_dirs[@]}"; do
        if [[ -d "$dir" ]]; then
            # Check if directory is world-writable
            if [[ -w "$dir" ]] && [[ "$(stat -c %a "$dir" 2>/dev/null || stat -f %Lp "$dir" 2>/dev/null)" =~ [2367]$ ]]; then
                found=1
                break
            fi
            # Check for world-writable files in PATH directories
            if find "$dir" -maxdepth 1 -type f -perm -002 2>/dev/null | grep -q .; then
                found=1
                break
            fi
        fi
    done
    [[ $found -eq 0 ]]
}

check_home_permissions() {
    local home_dir="$HOME"
    local perms
    if [[ "$OS_TYPE" == "linux" ]]; then
        perms=$(stat -c %a "$home_dir" 2>/dev/null)
    else
        perms=$(stat -f %Lp "$home_dir" 2>/dev/null)
    fi
    # Should be 700, 750, or 755 (no world-write)
    [[ "$perms" =~ ^7[05][05]$ ]]
}

check_no_suid_in_home() {
    # Check for SUID/SGID files in home directory
    ! find "$HOME" -type f \( -perm -4000 -o -perm -2000 \) 2>/dev/null | grep -q .
}

check_tmp_noexec() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check if /tmp is mounted with noexec
        mount | grep " /tmp " | grep -q "noexec"
    else
        # Not typically done on macOS
        return 0
    fi
}

check_secure_umask() {
    local current_umask
    current_umask=$(umask)
    # Secure umask should be 027, 077, or stricter
    # 027 = no write for group, no access for others
    # 077 = no access for group or others
    case "$current_umask" in
        0027|027|0077|077|0077|0027) return 0 ;;
        *)
            # Check numeric value - should mask at least group write and other rwx
            local mask_val=$((8#$current_umask))
            [[ $mask_val -ge $((8#027)) ]]
            ;;
    esac
}

ENV_FILES_COUNT=0

check_env_files() {
    EXPOSED_ENV_LIST=()
    while IFS= read -r envfile; do
        # Skip templates and examples
        [[ "$envfile" == *.example ]] && continue
        [[ "$envfile" == *.sample ]] && continue
        [[ "$envfile" == *.template ]] && continue
        # Skip test fixtures and IDE internals
        [[ "$envfile" == */testdata/* ]] && continue
        [[ "$envfile" == */test/* ]] && continue
        [[ "$envfile" == */fixtures/* ]] && continue
        [[ "$envfile" == */.vscode/* ]] && continue
        [[ "$envfile" == */.idea/* ]] && continue
        EXPOSED_ENV_LIST+=("$envfile")
    done < <(find "$HOME" \
        -path "*/node_modules" -prune -o \
        -path "*/.git" -prune -o \
        -path "*/go/pkg/mod" -prune -o \
        -path "*/.cache" -prune -o \
        -path "*/vendor" -prune -o \
        -path "*/.local/share" -prune -o \
        \( -name ".env" -o -name ".env.*" \) -print 2>/dev/null)
    ENV_FILES_COUNT=${#EXPOSED_ENV_LIST[@]}
    [[ "$ENV_FILES_COUNT" -eq 0 ]]
}

run_filesystem_checks() {
    local category="FILE SYSTEM"

    run_check "$category" "No world-writable in PATH" 75 "check_no_world_writable_in_path" || true
    run_check "$category" "Home dir permissions" 50 "check_home_permissions" || true
    run_check "$category" "No SUID files in home" 50 "check_no_suid_in_home" || true

    if [[ "$OS_TYPE" == "linux" ]]; then
        run_check "$category" "Tmp mounted noexec" 50 "check_tmp_noexec" || true
    fi

    run_check "$category" "Secure umask" 50 "check_secure_umask" || true

    # Check for .env files and show count - deduct points for each one found
    animate_turtle "Scanning for .env files"
    check_env_files || true
    add_max 50
    if [[ "$ENV_FILES_COUNT" -eq 0 ]]; then
        record_check "$category" "No .env files found" "1" "50" "50"
        add_score 50
    else
        local penalty=$((ENV_FILES_COUNT * 5))
        [[ $penalty -gt 100 ]] && penalty=100
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" ".env files found: $ENV_FILES_COUNT" "0" "-$penalty" "50"
    fi
}

# ═══════════════════════════════════════════════════════════════════════════════
# SECRETS & CREDENTIALS CHECKS
# ═══════════════════════════════════════════════════════════════════════════════

SECRETS_IN_HISTORY=0
EXPOSED_KEYS=0
CLOUD_CREDS_EXPOSED=0
declare -a SECRETS_FOUND=()
declare -a EXPOSED_KEYS_LIST=()
declare -a EXPOSED_CLOUD_LIST=()
declare -a EXPOSED_ENV_LIST=()

check_secrets_in_history() {
    # Check shell history files for secrets
    local history_files=("$HOME/.bash_history" "$HOME/.zsh_history" "$HOME/.history")
    # Match actual secret assignments (key=value or key: value with real-looking secrets)
    local patterns='(API[_-]?KEY|SECRET[_-]?KEY|AWS_SECRET_ACCESS_KEY|PRIVATE[_-]?KEY)[=:]["\x27]?[A-Za-z0-9+/=_-]{16,}'
    # Also match actual key material
    local key_patterns='-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----'
    # Crypto wallet patterns:
    #   Ethereum hex private key (0x + 64 hex chars)
    #   Bitcoin WIF (51-52 base58 chars starting with 5, K, or L) - no ^ anchor for zsh timestamps
    #   Solana private key (base58, 87-88 chars)
    #   Crypto CLI flags with key values
    local crypto_patterns='(0x[0-9a-fA-F]{64}|[^a-zA-Z0-9][5KL][1-9A-HJ-NP-Za-km-z]{50,51}[^a-zA-Z0-9]?|(--private-key|--seed|--mnemonic|--secret-key)[= ]["\x27]?[A-Za-z0-9])'
    # BIP39 seed phrases: 11+ lowercase words in a row (mnemonic)
    # Threshold at 11 to catch zsh line-wrapping that splits 12-word phrases
    local seed_pattern='([a-z]{3,8} ){10,23}[a-z]{3,8}'

    SECRETS_IN_HISTORY=0
    SECRETS_FOUND=()
    for hfile in "${history_files[@]}"; do
        if [[ -f "$hfile" ]]; then
            while IFS= read -r match; do
                # Split "linenum:content" from grep -n
                local lineno="${match%%:*}"
                local line="${match#*:}"
                # Skip common safe commands that match loosely
                [[ "$line" =~ (sudo passwd|ssh-keygen|gpg |man |--help|--password-stdin) ]] && continue
                [[ "$line" =~ (curl.*-u|wget|apt|pip|npm|brew) ]] && continue
                # Redact the secret value, keep the key name
                local redacted
                redacted=$(echo "$line" | sed -E \
                    -e 's/0x[0-9a-fA-F]{64}/0x*****/g' \
                    -e 's/[5KL][1-9A-HJ-NP-Za-km-z]{50,51}/*****[WIF]/g' \
                    -e 's/([=:]["'"'"']?)[A-Za-z0-9+/=_-]{16,}/\1*****/g' \
                    | cut -c1-80)
                # Strip zsh timestamp prefix for cleaner output
                redacted=$(echo "$redacted" | sed -E 's/^: [0-9]+:[0-9]+;//')
                SECRETS_FOUND+=("$(basename "$hfile"):$lineno: $redacted")
                SECRETS_IN_HISTORY=$((SECRETS_IN_HISTORY + 1))
            done < <(grep -nE "$patterns|$key_patterns|$crypto_patterns" "$hfile" 2>/dev/null | head -10)

            # Separate check for seed phrases (11+ lowercase words)
            while IFS= read -r match; do
                local lineno="${match%%:*}"
                local line="${match#*:}"
                [[ "$line" =~ (echo|man |cat |grep |--help) ]] && continue
                # Strip zsh timestamp prefix, then show first word + count
                local clean
                clean=$(echo "$line" | sed -E 's/^: [0-9]+:[0-9]+;//')
                local word_count
                word_count=$(echo "$clean" | wc -w | tr -d ' ')
                local first_word
                first_word=$(echo "$clean" | awk '{print $1}')
                SECRETS_FOUND+=("$(basename "$hfile"):$lineno: ${first_word} ... (${word_count} words) [seed phrase]")
                SECRETS_IN_HISTORY=$((SECRETS_IN_HISTORY + 1))
            done < <(grep -nE "$seed_pattern" "$hfile" 2>/dev/null | head -5)
        fi
    done
    [[ "$SECRETS_IN_HISTORY" -eq 0 ]]
}

check_cloud_credentials_exposed() {
    # Check if cloud credential files are world-readable
    local cred_files=(
        "$HOME/.aws/credentials"
        "$HOME/.azure/credentials"
        "$HOME/.config/gcloud/credentials.db"
        "$HOME/.config/gcloud/application_default_credentials.json"
        "$HOME/.boto"
        "$HOME/.s3cfg"
    )

    CLOUD_CREDS_EXPOSED=0
    EXPOSED_CLOUD_LIST=()
    for cfile in "${cred_files[@]}"; do
        if [[ -f "$cfile" ]]; then
            local perms
            if [[ "$OS_TYPE" == "linux" ]]; then
                perms=$(stat -c %a "$cfile" 2>/dev/null)
            else
                perms=$(stat -f %Lp "$cfile" 2>/dev/null)
            fi
            # Check if world or group readable (perms end in non-zero for group/other)
            if [[ "$perms" =~ [^0]$ ]] || [[ "$perms" =~ [^0][0-9]$ && ! "$perms" =~ ^[67]00$ ]]; then
                CLOUD_CREDS_EXPOSED=$((CLOUD_CREDS_EXPOSED + 1))
                EXPOSED_CLOUD_LIST+=("$cfile (mode: $perms)")
            fi
        fi
    done
    [[ "$CLOUD_CREDS_EXPOSED" -eq 0 ]]
}

check_exposed_private_keys() {
    # Find private key files with bad permissions
    EXPOSED_KEYS=0
    EXPOSED_KEYS_LIST=()

    while IFS= read -r keyfile; do
        if [[ -f "$keyfile" ]]; then
            local perms
            if [[ "$OS_TYPE" == "linux" ]]; then
                perms=$(stat -c %a "$keyfile" 2>/dev/null)
            else
                perms=$(stat -f %Lp "$keyfile" 2>/dev/null)
            fi
            # Should be 600 or 400, not group/world readable
            if [[ ! "$perms" =~ ^[46]00$ ]]; then
                EXPOSED_KEYS=$((EXPOSED_KEYS + 1))
                EXPOSED_KEYS_LIST+=("$keyfile (mode: $perms)")
            fi
        fi
    done < <(find "$HOME" -maxdepth 3 -type f \( -name "*.pem" -o -name "*.key" -o -name "id_rsa" -o -name "id_ecdsa" -o -name "id_ed25519" -o -name "*.ppk" \) 2>/dev/null)

    [[ "$EXPOSED_KEYS" -eq 0 ]]
}

BROWSER_PASSWORDS=0

check_browser_passwords() {
    # Check for unencrypted browser password databases
    local browser_paths=(
        "$HOME/.config/google-chrome/Default/Login Data"
        "$HOME/.config/chromium/Default/Login Data"
        "$HOME/.mozilla/firefox/*/logins.json"
        "$HOME/Library/Application Support/Google/Chrome/Default/Login Data"
        "$HOME/Library/Application Support/Firefox/Profiles/*/logins.json"
    )

    BROWSER_PASSWORDS=0
    for pattern in "${browser_paths[@]}"; do
        # Use eval to expand globs
        for bfile in $pattern; do
            if [[ -f "$bfile" ]]; then
                BROWSER_PASSWORDS=$((BROWSER_PASSWORDS + 1))
            fi
        done 2>/dev/null
    done

    # Having browser password files isn't necessarily bad if the browser encrypts them
    # But we flag it as a warning - these are high-value targets
    [[ "$BROWSER_PASSWORDS" -eq 0 ]]
}

check_sudo_timestamp() {
    # Check if sudo caches credentials for too long
    if [[ -f /etc/sudoers ]]; then
        # Check for timestamp_timeout setting
        local timeout
        timeout=$(grep -E "timestamp_timeout" /etc/sudoers /etc/sudoers.d/* 2>/dev/null | grep -oE '[0-9]+' | head -1)

        if [[ -z "$timeout" ]]; then
            # Default is usually 5-15 minutes, which is reasonable
            return 0
        elif [[ "$timeout" -eq 0 ]]; then
            # 0 means always ask - very secure
            return 0
        elif [[ "$timeout" -lt 0 ]]; then
            # Negative means never expires - bad!
            return 1
        elif [[ "$timeout" -gt 30 ]]; then
            # More than 30 minutes is risky
            return 1
        fi
    fi
    return 0
}

run_secrets_checks() {
    local category="SECRETS & CREDS"

    # Secrets in history
    animate_turtle "Checking shell history"
    check_secrets_in_history || true
    add_max 50
    if [[ "$SECRETS_IN_HISTORY" -eq 0 ]]; then
        record_check "$category" "No secrets in shell history" "1" "50" "50"
        add_score 50
    else
        local penalty=$((SECRETS_IN_HISTORY * 10))
        [[ $penalty -gt 150 ]] && penalty=150
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "Secrets in history: $SECRETS_IN_HISTORY" "0" "-$penalty" "50"
    fi

    # Cloud credentials exposed
    animate_turtle "Checking cloud credentials"
    check_cloud_credentials_exposed || true
    add_max 50
    if [[ "$CLOUD_CREDS_EXPOSED" -eq 0 ]]; then
        record_check "$category" "Cloud creds protected" "1" "50" "50"
        add_score 50
    else
        local penalty=$((CLOUD_CREDS_EXPOSED * 50))
        [[ $penalty -gt 150 ]] && penalty=150
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "Exposed cloud creds: $CLOUD_CREDS_EXPOSED" "0" "-$penalty" "50"
    fi

    # Private keys with bad permissions
    animate_turtle "Checking private keys"
    check_exposed_private_keys || true
    add_max 50
    if [[ "$EXPOSED_KEYS" -eq 0 ]]; then
        record_check "$category" "Private keys protected" "1" "50" "50"
        add_score 50
    else
        local penalty=$((EXPOSED_KEYS * 25))
        [[ $penalty -gt 150 ]] && penalty=150
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "Exposed private keys: $EXPOSED_KEYS" "0" "-$penalty" "50"
    fi

    # Browser password databases (informational - browsers encrypt these)
    animate_turtle "Checking browser passwords"
    check_browser_passwords || true
    if [[ "$BROWSER_PASSWORDS" -gt 0 ]]; then
        record_check "$category" "Browser password DBs: $BROWSER_PASSWORDS" "skip" "0" "0"
    fi

    # Sudo timestamp
    animate_turtle "Checking sudo timeout"
    run_check "$category" "Sudo timeout reasonable" 25 "check_sudo_timestamp" || true

    # Secrets in shell config
    animate_turtle "Checking shell config"
    check_secrets_in_shell_config || true
    add_max 50
    if [[ "$SECRETS_IN_CONFIG" -eq 0 ]]; then
        record_check "$category" "No secrets in shell config" "1" "50" "50"
        add_score 50
    else
        local penalty=$((SECRETS_IN_CONFIG * 15))
        [[ $penalty -gt 100 ]] && penalty=100
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "Secrets in shell config: $SECRETS_IN_CONFIG" "0" "-$penalty" "50"
    fi

    # Git credential helper
    animate_turtle "Checking git credentials"
    run_check "$category" "Git creds not in plaintext" 50 "check_git_credential_helper" || true

    # SSH agent forwarding
    animate_turtle "Checking SSH config"
    run_check "$category" "SSH agent forwarding safe" 25 "check_ssh_agent_forwarding" || true

    # Docker socket
    animate_turtle "Checking Docker socket"
    run_check "$category" "Docker socket protected" 50 "check_docker_socket" || true

    # Crypto wallets on disk (informational - these are stealer targets)
    animate_turtle "Scanning for crypto wallets"
    check_crypto_wallets || true
    if [[ "$CRYPTO_WALLETS_FOUND" -gt 0 ]]; then
        record_check "$category" "!! Crypto wallets found: $CRYPTO_WALLETS_FOUND (stealer target)" "skip" "0" "0"
    fi

    # Dev tokens (npm, pypi, netrc, kube, docker, terraform)
    animate_turtle "Checking dev tokens"
    check_dev_tokens || true
    add_max 50
    if [[ "$DEV_TOKENS_FOUND" -eq 0 ]]; then
        record_check "$category" "No exposed dev tokens" "1" "50" "50"
        add_score 50
    else
        local penalty=$((DEV_TOKENS_FOUND * 20))
        [[ $penalty -gt 100 ]] && penalty=100
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "!! Exposed dev tokens: $DEV_TOKENS_FOUND" "0" "-$penalty" "50"
    fi

    # Session tokens (Discord, Slack, Telegram - informational)
    animate_turtle "Checking app sessions"
    check_session_tokens || true
    if [[ "$SESSION_TOKENS_FOUND" -gt 0 ]]; then
        record_check "$category" "App sessions found: $SESSION_TOKENS_FOUND (stealer target)" "skip" "0" "0"
    fi

    # VPN/WiFi configs with embedded keys
    animate_turtle "Checking VPN & WiFi configs"
    check_vpn_wifi_configs || true
    add_max 50
    if [[ "$VPN_CONFIGS_FOUND" -eq 0 ]]; then
        record_check "$category" "No exposed VPN/WiFi creds" "1" "50" "50"
        add_score 50
    else
        local penalty=$((VPN_CONFIGS_FOUND * 20))
        [[ $penalty -gt 100 ]] && penalty=100
        TOTAL_SCORE=$((TOTAL_SCORE - penalty))
        record_check "$category" "!! Exposed VPN/WiFi creds: $VPN_CONFIGS_FOUND" "0" "-$penalty" "50"
    fi

    # GPG key protection
    animate_turtle "Checking GPG keys"
    check_gpg_protection || true
    if [[ "$GPG_WEAK_KEYS" -gt 0 ]]; then
        TOTAL_SCORE=$((TOTAL_SCORE - 25))
        record_check "$category" "GPG directory weak permissions" "0" "-25" "0"
    fi

    # Password vault file permissions
    animate_turtle "Checking password vaults"
    check_password_vault_files || true
    if [[ "$VAULT_ISSUES" -gt 0 ]]; then
