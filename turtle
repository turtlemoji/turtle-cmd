SSH_KEY_ISSUES=0
declare -a SSH_KEY_ISSUES_LIST=()

check_ssh_key_audit() {
    SSH_KEY_ISSUES=0
    SSH_KEY_ISSUES_LIST=()

    [[ ! -d "$HOME/.ssh" ]] && return 0

    while IFS= read -r keyfile; do
        [[ ! -f "$keyfile" ]] && continue
        # Skip public keys and config files
        [[ "$keyfile" == *.pub ]] && continue
        [[ "$(basename "$keyfile")" == "config" ]] && continue
        [[ "$(basename "$keyfile")" == "known_hosts"* ]] && continue
        [[ "$(basename "$keyfile")" == "authorized_keys"* ]] && continue

        # Check if it's actually a private key
        if ! head -1 "$keyfile" 2>/dev/null | grep -qE '(BEGIN|PRIVATE|OPENSSH)'; then
            continue
        fi

        local key_type="" key_bits="" key_age_days=0
        local basename_key
        basename_key=$(basename "$keyfile")

        # Get key info via ssh-keygen
        local key_info
        key_info=$(ssh-keygen -l -f "$keyfile" 2>/dev/null || echo "")
        if [[ -n "$key_info" ]]; then
            key_bits=$(echo "$key_info" | awk '{print $1}')
            key_type=$(echo "$key_info" | grep -oE '\(.*\)' | tr -d '()')
        fi

        # Get key age from file mtime
        local mtime_epoch
        if [[ "$OS_TYPE" == "linux" ]]; then
            mtime_epoch=$(stat -c %Y "$keyfile" 2>/dev/null || echo "0")
        else
            mtime_epoch=$(stat -f %m "$keyfile" 2>/dev/null || echo "0")
        fi
        if [[ "$mtime_epoch" -gt 0 ]]; then
            local now_epoch
            now_epoch=$(date +%s)
            key_age_days=$(( (now_epoch - mtime_epoch) / 86400 ))
        fi

        local issue=""
        # Flag DSA keys (deprecated)
        if [[ "$key_type" == "DSA" ]]; then
            issue="DSA (deprecated, insecure)"
        # Flag small RSA keys
        elif [[ "$key_type" == "RSA" ]] && [[ "$key_bits" -lt 3072 ]]; then
            issue="RSA-${key_bits} (weak, use ed25519)"
        # Flag old keys (> 2 years)
        elif [[ "$key_age_days" -gt 730 ]]; then
            local years=$((key_age_days / 365))
            issue="${key_type:-unknown}-${key_bits:-?} (${years}y old, consider rotating)"
        fi

        if [[ -n "$issue" ]]; then
            SSH_KEY_ISSUES=$((SSH_KEY_ISSUES + 1))
            SSH_KEY_ISSUES_LIST+=("$basename_key: $issue")
        fi
    done < <(find "$HOME/.ssh" -maxdepth 1 -type f 2>/dev/null)

    [[ "$SSH_KEY_ISSUES" -eq 0 ]]
}

check_unencrypted_backups() {
    if [[ "$OS_TYPE" == "linux" ]]; then
        # Check for mounted external/removable drives that are not encrypted
        while IFS= read -r mount_line; do
            local dev mount_point fstype
            dev=$(echo "$mount_line" | awk '{print $1}')
            mount_point=$(echo "$mount_line" | awk '{print $3}')
            fstype=$(echo "$mount_line" | awk '{print $5}')

            # Skip virtual/system filesystems
            [[ "$fstype" =~ ^(tmpfs|devtmpfs|sysfs|proc|cgroup|overlay|squashfs)$ ]] && continue
            [[ "$mount_point" == "/" ]] && continue
            [[ "$mount_point" == "/boot"* ]] && continue
            [[ "$mount_point" == "/snap"* ]] && continue

            # Check if it's a removable/external drive with backup-like content
            if [[ "$mount_point" =~ (media|mnt|backup|Backup) ]]; then
                # Check if LUKS encrypted
                if ! command -v lsblk &>/dev/null || ! lsblk -no TYPE "$dev" 2>/dev/null | grep -q "crypt"; then
                    # Check if it contains backup-like directories
                    if [[ -d "$mount_point/timeshift" ]] || [[ -d "$mount_point/borg" ]] || \
                       [[ -d "$mount_point/restic" ]] || [[ -d "$mount_point/backup" ]] || \
                       [[ -d "$mount_point/Backup" ]]; then
                        return 1
                    fi
                fi
            fi
        done < <(mount 2>/dev/null | grep "^/dev/")
    elif [[ "$OS_TYPE" == "macos" ]]; then
        # Check Time Machine encryption
        if command -v tmutil &>/dev/null; then
            local tm_info
            tm_info=$(tmutil destinationinfo 2>/dev/null || echo "")
            if [[ -n "$tm_info" ]] && echo "$tm_info" | grep -q "Name"; then
                if ! echo "$tm_info" | grep -qi "encrypted.*yes\|encryption.*yes"; then
                    return 1
                fi
            fi
        fi
    fi
    return 0
}

PKG_VULNS_FOUND=0
